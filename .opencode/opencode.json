{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "community-n8n": {
      "type": "local",
      "enabled": true,
      "command": [
        "npx",
        "-y",
        "n8n-mcp"
      ],
      "environment": {
        "MCP_MODE": "stdio",
        "LOG_LEVEL": "error",
        "DISABLE_CONSOLE_OUTPUT": "false",
        "N8N_API_URL": "http://localhost:5678",
        "N8N_API_KEY": "{file:~/.config/opencode/n8n-community-api.key}",
        "WEBHOOK_SECURITY_MODE": "moderate"
      }
    }
  }
}